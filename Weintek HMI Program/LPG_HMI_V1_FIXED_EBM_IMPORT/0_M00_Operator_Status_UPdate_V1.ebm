macro_definition_begin
    "id": "0"
    "name": "M00_Operator_Status_UPdate_V1"
    "startup": "false"
    "periodic": [ "true", "2" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M00_Operator_Status_Update_V1
// Updates progress, recommended next step,
// and operator button enable bits.
// =============================================================

macro_command main()

short err = 0
short fillState = 0
short alarmCode = 0
short readyStart = 0
short canStop = 0
short stepCode = 0

short prepareEnable = 0
short startEnable = 0
short stopEnable = 0
short nextEnable = 0
short alarmActive = 0
short commFault = 0

float net = 0.0
float target = 0.0
float progress = 0.0
float desiredKg = 0.0
float desiredAmount = 0.0

// -------------------------------------------------------------
// Read controller status
// -------------------------------------------------------------

GetDataEx(fillState, "LPG-Controller", 4x, 14, 1)
GetError(err)

GetDataEx(alarmCode, "LPG-Controller", 4x, 72, 1)
GetDataEx(readyStart, "LPG-Controller", 4x, 137, 1)
GetDataEx(canStop, "LPG-Controller", 4x, 139, 1)

// -------------------------------------------------------------
// Read weights
// -------------------------------------------------------------

GetDataEx(net, "LPG-Controller", 4x_Double, 4, 1)
GetDataEx(target, "LPG-Controller", 4x_Double, 6, 1)

// -------------------------------------------------------------
// Calculate progress
// -------------------------------------------------------------

if target > 0.001 then
    progress = net * 100.0 / target
else
    progress = 0.0
end if

if progress < 0.0 then
    progress = 0.0
end if

if progress > 100.0 then
    progress = 100.0
end if

SetData(progress, "Local HMI", LW, 1420, 1)

// -------------------------------------------------------------
// Read operator inputs
// -------------------------------------------------------------

GetData(desiredKg, "Local HMI", LW, 1404, 1)
GetData(desiredAmount, "Local HMI", LW, 1406, 1)

// -------------------------------------------------------------
// Read HMI system communication fault
// LB9045 = memory-map / communication fail
// -------------------------------------------------------------

GetData(commFault, "Local HMI", LB, 9045, 1)

// -------------------------------------------------------------
// Alarm active bit
// -------------------------------------------------------------

if alarmCode <> 0 then
    alarmActive = 1
else
    alarmActive = 0
end if

// -------------------------------------------------------------
// Recommended next step code
// LW1450
// 0 = System idle
// 1 = Enter sale values and press PREPARE CYLINDER.
// 2 = Press PREPARE CYLINDER.
// 3 = Press START FILLING.
// 4 = Filling in progress. Press STOP only if needed.
// 5 = Fill complete. Press NEXT CYLINDER.
// 6 = Alarm active. Resolve alarm before filling.
// -------------------------------------------------------------

if alarmActive == 1 then
    stepCode = 6
else
    if canStop == 1 then
        stepCode = 4
    else
        if fillState == 6 then
            stepCode = 5
        else
            if readyStart == 1 then
                stepCode = 3
            else
                if desiredKg > 0.001 then
                    stepCode = 2
                else
                    if desiredAmount > 0.001 then
                        stepCode = 2
                    else
                        stepCode = 1
                    end if
                end if
            end if
        end if
    end if
end if

SetData(stepCode, "Local HMI", LW, 1450, 1)

// -------------------------------------------------------------
// Button enable bits
// LB1500 = Prepare Cylinder Enable
// LB1501 = Start Filling Enable
// LB1502 = Stop Filling Enable
// LB1503 = Next Cylinder Enable
// LB1504 = Alarm Active
// LB1505 = Communication Fault
// -------------------------------------------------------------

// Prepare allowed:
// no alarm, not filling, sale value entered
if alarmActive == 0 then
    if canStop == 0 then
        if desiredKg > 0.001 then
            prepareEnable = 1
        else
            if desiredAmount > 0.001 then
                prepareEnable = 1
            end if
        end if
    end if
end if

// Start allowed:
// no alarm and controller Ready To Start = 1
if alarmActive == 0 then
    if readyStart == 1 then
        startEnable = 1
    end if
end if

// Stop allowed:
// controller says Can Stop = 1
if canStop == 1 then
    stopEnable = 1
end if

// Next allowed:
// Fill State COMPLETE = 6
if fillState == 6 then
    nextEnable = 1
end if

SetData(prepareEnable, "Local HMI", LB, 1500, 1)
SetData(startEnable, "Local HMI", LB, 1501, 1)
SetData(stopEnable, "Local HMI", LB, 1502, 1)
SetData(nextEnable, "Local HMI", LB, 1503, 1)
SetData(alarmActive, "Local HMI", LB, 1504, 1)
SetData(commFault, "Local HMI", LB, 1505, 1)

SetData(err, "Local HMI", LW, 1424, 1)

end macro_command