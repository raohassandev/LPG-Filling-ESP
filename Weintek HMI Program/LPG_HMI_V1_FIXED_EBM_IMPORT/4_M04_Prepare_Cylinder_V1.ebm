macro_definition_begin
    "id": "4"
    "name": "M04_Prepare_Cylinder_V1"
    "startup": "false"
    "periodic": [ "false" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M04_Prepare_Cylinder_V1
// FIXED SELF-CONTAINED VERSION
// Does not depend on Global Library command sender.
// Root fix: after Zero Net command 12, wait until controller
// accepts sequence before sending Prepare command 10.
// =============================================================

macro_command main()

short err = 0
short mode = 0
short cmd = 0
short lastSeq = 0
short localSeq = 0
short seq = 0
short ready = 0
short stepCode = 0

float price = 0.0
float kg = 0.0
float amount = 0.0
float tare = 0.0

// -------------------------------------------------------------
// Read operator values
// -------------------------------------------------------------

GetData(mode, "Local HMI", LW, 1400, 1)
GetData(price, "Local HMI", RW, 1402, 1)
GetData(kg, "Local HMI", LW, 1404, 1)
GetData(amount, "Local HMI", LW, 1406, 1)

if price <= 0.0 then
    err = 201
end if

// Auto calculate sale values
if err == 0 then

    if mode == 0 then

        if kg <= 0.0 then
            err = 202
        else
            amount = kg * price
            SetData(amount, "Local HMI", LW, 1406, 1)
        end if

    else

        if amount <= 0.0 then
            err = 203
        else
            kg = amount / price
            SetData(kg, "Local HMI", LW, 1404, 1)
        end if

    end if

end if

// -------------------------------------------------------------
// Command 12 = Zero Net / Capture Tare
// -------------------------------------------------------------

if err == 0 then

    GetData(localSeq, "Local HMI", LW, 1422, 1)
    GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
    GetError(err)

    if err == 0 then
        seq = localSeq + 1
        if seq <= lastSeq then
            seq = lastSeq + 1
        end if
        if seq >= 30000 then
            seq = 1
        end if

        cmd = 12
        SetData(seq, "Local HMI", LW, 1422, 1)
        SetData(cmd, "Local HMI", LW, 1423, 1)
        SetData(lastSeq, "Local HMI", LW, 1425, 1)

        SetDataEx(cmd, "LPG-Controller", 4x, 128, 1)
        GetError(err)

        if err == 0 then
            SetDataEx(seq, "LPG-Controller", 4x, 129, 1)
            GetError(err)
        end if
    end if

end if

// Wait until controller accepts command 12
if err == 0 then
    DELAY(150)
    GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
    GetError(err)
end if

if err == 0 then
    if lastSeq <> seq then
        DELAY(150)
        GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
        GetError(err)
    end if
end if

if err == 0 then
    if lastSeq <> seq then
        DELAY(150)
        GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
        GetError(err)
    end if
end if

if err == 0 then
    if lastSeq <> seq then
        DELAY(150)
        GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
        GetError(err)
    end if
end if

if err == 0 then
    SetData(lastSeq, "Local HMI", LW, 1425, 1)
    if lastSeq <> seq then
        err = 301
    end if
end if

// -------------------------------------------------------------
// Read actual tare after zero net
// -------------------------------------------------------------

if err == 0 then
    DELAY(120)
    GetDataEx(tare, "LPG-Controller", 4x_Double, 2, 1)
    GetError(err)
end if

// -------------------------------------------------------------
// Write mode and HMI presets
// -------------------------------------------------------------

if err == 0 then
    SetDataEx(mode, "LPG-Controller", 4x, 134, 1)
    GetError(err)
end if

if err == 0 then
    SetDataEx(tare, "LPG-Controller", 4x_Double, 144, 1)
    GetError(err)
end if

if err == 0 then
    SetDataEx(kg, "LPG-Controller", 4x_Double, 146, 1)
    GetError(err)
end if

if err == 0 then
    SetDataEx(price, "LPG-Controller", 4x_Double, 148, 1)
    GetError(err)
end if

if err == 0 then
    SetDataEx(amount, "LPG-Controller", 4x_Double, 150, 1)
    GetError(err)
end if

// -------------------------------------------------------------
// Command 10 = Prepare
// -------------------------------------------------------------

if err == 0 then

    seq = seq + 1
    if seq >= 30000 then
        seq = 1
    end if

    cmd = 10
    SetData(seq, "Local HMI", LW, 1422, 1)
    SetData(cmd, "Local HMI", LW, 1423, 1)
    SetData(lastSeq, "Local HMI", LW, 1425, 1)

    SetDataEx(cmd, "LPG-Controller", 4x, 128, 1)
    GetError(err)

    if err == 0 then
        SetDataEx(seq, "LPG-Controller", 4x, 129, 1)
        GetError(err)
    end if

end if

// Wait until controller accepts command 10
if err == 0 then
    DELAY(150)
    GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
    GetError(err)
end if

if err == 0 then
    if lastSeq <> seq then
        DELAY(150)
        GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
        GetError(err)
    end if
end if

if err == 0 then
    if lastSeq <> seq then
        DELAY(150)
        GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
        GetError(err)
    end if
end if

if err == 0 then
    SetData(lastSeq, "Local HMI", LW, 1425, 1)
    if lastSeq <> seq then
        err = 302
    end if
end if

// Check ready to start once
if err == 0 then
    DELAY(150)
    GetDataEx(ready, "LPG-Controller", 4x, 137, 1)
    GetError(err)
end if

if err == 0 then
    if ready == 1 then
        stepCode = 3
        SetData(stepCode, "Local HMI", LW, 1450, 1)
    else
        // Prepare accepted but controller not ready yet.
        // Periodic status macro will update message when 4x137 becomes 1.
        stepCode = 2
        SetData(stepCode, "Local HMI", LW, 1450, 1)
    end if
end if

SetData(err, "Local HMI", LW, 1424, 1)
SetData(err, "Local HMI", LW, 899, 1)

end macro_command
