macro_definition_begin
    "id": "30"
    "name": "M30_Start_Filling_V1"
    "startup": "false"
    "periodic": [ "false" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M30_Start_Filling_V1
// SELF-CONTAINED command macro. No Global Library dependency.
// =============================================================

macro_command main()

short err = 0
short cmd = 30
short lastSeq = 0
short localSeq = 0
short seq = 0
short enable = 0
short fillState = 0
short sendCommand = 1
short stepCode = 0
float zero = 0.0


// Check local Start Enable bit
GetData(enable, "Local HMI", LB, 1501, 1)

if enable <> 1 then
    err = 137
end if

if err == 0 then

    if sendCommand == 1 then

        GetData(localSeq, "Local HMI", LW, 1422, 1)
        GetDataEx(lastSeq, "LPG-Controller", 4x, 130, 1)
        GetError(err)

        if err == 0 then
            seq = localSeq + 1
            if seq <= lastSeq then
                seq = lastSeq + 1
            end if
            if seq >= 30000 then
                seq = 1
            end if

            SetData(seq, "Local HMI", LW, 1422, 1)
            SetData(cmd, "Local HMI", LW, 1423, 1)
            SetData(lastSeq, "Local HMI", LW, 1425, 1)

            SetDataEx(cmd, "LPG-Controller", 4x, 128, 1)
            GetError(err)

            if err == 0 then
                SetDataEx(seq, "LPG-Controller", 4x, 129, 1)
                GetError(err)
            end if
        end if

    end if

end if

if err == 0 then
    stepCode = 4
    SetData(stepCode, "Local HMI", LW, 1450, 1)
end if

SetData(err, "Local HMI", LW, 1424, 1)
SetData(err, "Local HMI", LW, 899, 1)

end macro_command
