{
  "name": "lpg-weintek-modbus-tools",
  "version": "1.0.0",
  "description": "Modbus RTU R&D diagnostic tools for Weintek HMI / LPG filling controller",
  "private": true,
  "scripts": {
    "ports": "node tools/list-serial-ports.js",
    "probe": "node tools/modbus-liveweight-probe.js",
    "probe9600": "node tools/modbus-liveweight-probe.js --baud 9600",
    "probe115200": "node tools/modbus-liveweight-probe.js --baud 115200",
    "probe:com2": "node tools/modbus-liveweight-probe.js --port COM2 --baud 115200 --id 1 --timeout 200 --retries 3 --retry-delay 50 --req-gap 20",
    "probe:com2:scan": "node tools/modbus-liveweight-probe.js --port COM2 --baud-scan",
    "probe:com10": "node tools/modbus-liveweight-probe.js --port COM10 --baud 9600 --id 1",
    "audit:modbus-map": "node tools/modbus-map-audit.js",
    "gen:weintek-tags": "node tools/generate-weintek-tags.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "modbus-serial": "^8.0.20",
    "serialport": "^12.0.0"
  }
}
