macro_definition_begin
    "id": "31"
    "name": "M31_Stop_Filling"
    "startup": "false"
    "periodic": [ "false" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M31_Stop_Filling
// Sends command 31.
// Stop should be available even if HMI enable bit is stale.
// =============================================================

macro_command main()

short err = 0
short cmd = 31
short stepCode = 2

err = LPG_SendCommand(cmd)

if err == 0 then
    SetData(stepCode, "Local HMI", LW, 1450, 1)
end if

SetData(err, "Local HMI", LW, 1424, 1)
SetData(err, "Local HMI", LW, 899, 1)

end macro_command
