macro_definition_begin
    "id": "5"
    "name": "M05_Local_Calculation"
    "startup": "false"
    "periodic": [ "true", "3" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M05_Local_Calculation
// Run every 300 ms.
// Local only. No Modbus traffic.
// KG mode: Amount = KG x Price
// Amount mode: KG = Amount / Price
// =============================================================

macro_command main()

short mode = 0

float price = 0.0
float kg = 0.0
float amount = 0.0

GetData(mode, "Local HMI", LW, 1400, 1)
GetData(price, "Local HMI", RW, 1402, 1)
GetData(kg, "Local HMI", LW, 1404, 1)
GetData(amount, "Local HMI", LW, 1406, 1)

if price > 0.0 then

    if mode == 0 then
        amount = kg * price
        SetData(amount, "Local HMI", LW, 1406, 1)
    else
        kg = amount / price
        SetData(kg, "Local HMI", LW, 1404, 1)
    end if

end if

end macro_command
