macro_definition_begin
    "id": "4"
    "name": "M04_Prepare_Cylinder_V1"
    "startup": "false"
    "periodic": [ "false" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M04_Prepare_Cylinder_V1
// SAFE FAST VERSION
// 1. Calculate sale values
// 2. Zero Net / Capture Tare
// 3. Wait
// 4. Write mode + presets
// 5. Prepare
// =============================================================

macro_command main()

short err = 0
short mode = 0
short cmd = 0
short stepCode = 0

float price = 0.0
float kg = 0.0
float amount = 0.0
float tare = 0.0

GetData(mode, "Local HMI", LW, 1400, 1)
GetData(price, "Local HMI", RW, 1402, 1)
GetData(kg, "Local HMI", LW, 1404, 1)
GetData(amount, "Local HMI", LW, 1406, 1)

if price <= 0.0 then
    err = 201
end if

if err == 0 then

    if mode == 0 then

        if kg <= 0.0 then
            err = 202
        else
            amount = kg * price
            SetData(amount, "Local HMI", LW, 1406, 1)
        end if

    else

        if amount <= 0.0 then
            err = 203
        else
            kg = amount / price
            SetData(kg, "Local HMI", LW, 1404, 1)
        end if

    end if

end if

// Capture tare / zero net
if err == 0 then
    cmd = 12
    SetData(cmd, "Local HMI", LW, 1423, 1)
    err = LPG_SendPendingCommand_V1()
end if

// Wait for controller to accept/apply command 12
if err == 0 then
    DELAY(600)
end if

// Read actual tare after zero net
if err == 0 then
    GetDataEx(tare, "LPG-Controller", 4x_Double, 2, 1)
    GetError(err)
end if

// Fill mode = 4x134
if err == 0 then
    SetDataEx(mode, "LPG-Controller", 4x, 134, 1)
    GetError(err)
end if

// HMI preset tare = 4x144
if err == 0 then
    SetDataEx(tare, "LPG-Controller", 4x_Double, 144, 1)
    GetError(err)
end if

// HMI preset target KG = 4x146
if err == 0 then
    SetDataEx(kg, "LPG-Controller", 4x_Double, 146, 1)
    GetError(err)
end if

// HMI preset rate = 4x148
if err == 0 then
    SetDataEx(price, "LPG-Controller", 4x_Double, 148, 1)
    GetError(err)
end if

// HMI preset amount = 4x150
if err == 0 then
    SetDataEx(amount, "LPG-Controller", 4x_Double, 150, 1)
    GetError(err)
end if

// Prepare command
if err == 0 then
    cmd = 10
    SetData(cmd, "Local HMI", LW, 1423, 1)
    err = LPG_SendPendingCommand_V1()
end if

if err == 0 then
    stepCode = 3
    SetData(stepCode, "Local HMI", LW, 1450, 1)
end if

SetData(err, "Local HMI", LW, 1424, 1)
SetData(err, "Local HMI", LW, 899, 1)

end macro_command