macro_definition_begin
    "id": "33"
    "name": "M33_Next_Cylinder_V1"
    "startup": "false"
    "periodic": [ "false" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M33_Next_Cylinder_V1
// Clears next-cylinder values.
// Sends command 33 only if fill state is COMPLETE.
// Keeps price and mode.
// =============================================================

macro_command main()

short err = 0
short cmd = 33
short fillState = 0
short stepCode = 1

float zero = 0.0

// Read Fill State
GetDataEx(fillState, "LPG-Controller", 4x, 14, 1)
GetError(err)

// Send Ack Complete only if Fill State = COMPLETE
if err == 0 then

    if fillState == 6 then
        SetData(cmd, "Local HMI", LW, 1423, 1)
        err = LPG_SendPendingCommand_V1()
    end if

end if

// Clear next-cylinder operator inputs
SetData(zero, "Local HMI", LW, 1404, 1)
SetData(zero, "Local HMI", LW, 1406, 1)
SetData(zero, "Local HMI", LW, 1420, 1)
SetData(zero, "Local HMI", LW, 1440, 1)
SetData(zero, "Local HMI", LW, 1442, 1)

// Keep price per KG unchanged: RW1402
// Keep mode unchanged: LW1400

SetData(stepCode, "Local HMI", LW, 1450, 1)

SetData(err, "Local HMI", LW, 1424, 1)
SetData(err, "Local HMI", LW, 899, 1)

end macro_command