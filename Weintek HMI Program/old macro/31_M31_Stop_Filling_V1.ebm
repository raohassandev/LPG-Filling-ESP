macro_definition_begin
    "id": "31"
    "name": "M31_Stop_Filling_V1"
    "startup": "false"
    "periodic": [ "false" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M31_Stop_Filling_V1
// Stop filling.
// =============================================================

macro_command main()

short err = 0
short cmd = 31
short stepCode = 0

SetData(cmd, "Local HMI", LW, 1423, 1)

err = LPG_SendPendingCommand_V1()

if err == 0 then
    stepCode = 2
    SetData(stepCode, "Local HMI", LW, 1450, 1)
end if

SetData(err, "Local HMI", LW, 1424, 1)
SetData(err, "Local HMI", LW, 899, 1)

end macro_command