macro_definition_begin
    "id": "30"
    "name": "M30_Start_Filling_V1"
    "startup": "false"
    "periodic": [ "false" ]
    "interlock": [ "false" ]
macro_definition_end
// =============================================================
// M30_Start_Filling_V1
// FAST VERSION
// Uses LB1501 Start Enable.
// =============================================================

macro_command main()

short err = 0
short startEnable = 0
short cmd = 30
short stepCode = 0

// Read local Start Enable bit
GetData(startEnable, "Local HMI", LB, 1501, 1)

if startEnable == 1 then

    SetData(cmd, "Local HMI", LW, 1423, 1)

    err = LPG_SendPendingCommand_V1()

else

    // Not ready to start
    err = 137

end if

if err == 0 then
    stepCode = 4
    SetData(stepCode, "Local HMI", LW, 1450, 1)
end if

SetData(err, "Local HMI", LW, 1424, 1)
SetData(err, "Local HMI", LW, 899, 1)

end macro_command